#macro BSHAPE_CRYSTAL 13
#macro BSHAPE_RUNE 14
#macro BSHAPE_BUTTERFLY 15
#macro BSHAPE_FLAME 16
#macro BSHAPE_MOTE 17
#macro BSHAPE_COUNT 18

#macro BCOL_CRIMSON 0
#macro BCOL_EMBER 1
#macro BCOL_AMBER 2
#macro BCOL_GOLD 3
#macro BCOL_LIME 4
#macro BCOL_JADE 5
