        spr_bul_pellet,
        spr_bul_orb,
        spr_bul_ball,
        spr_bul_sphere,
        spr_bul_ring,
        spr_bul_bubble,
        spr_bul_rice,
        spr_bul_oval,
        spr_bul_dart,
        spr_bul_needle,
