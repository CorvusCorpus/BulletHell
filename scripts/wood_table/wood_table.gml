          trunk: [[23.3, 400.0, 85.8, 22.9], [17.9, 450.0, 95.4, 19.9], [12.0, 500.0, 103.8, 17.0], [7.2, 550.0, 112.3, 14.1], [3.3, 600.0, 121.7, 11.3]] },
        { file: "wood/tree_02.vbuf", soft: "wood/tree_02_soft.vbuf", far: "wood/tree_02_far.vbuf",
          species: "oak", height: 761.0, r0: 53.8, spread: 650.0, near: 526.7,
          hangs: [[298.1, 466.4, -106.3, 7.6, 0.87, 0.49, 0.01, 1.00], [417.2, 539.5, -92.0, 5.0, 0.87, 0.49, 0.06, 1.00]],
          trunk: [[187.8, 400.0, -99.9, 19.2], [199.8, 450.0, -131.7, 15.7], [205.1, 500.0, -161.2, 12.3], [206.7, 550.0, -186.3, 9.2]] },
