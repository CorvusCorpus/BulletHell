          trunk: [[43.3, 400.0, -12.1, 47.5], [48.3, 450.0, -13.1, 46.4], [53.9, 500.0, -13.3, 45.4], [60.1, 550.0, -13.9, 44.3], [67.1, 600.0, -15.1, 43.3], [74.5, 650.0, -16.5, 42.3], [81.8, 700.0, -17.8, 41.3], [89.0, 750.0, -18.8, 40.3], [96.2, 800.0, -19.5, 39.3], [103.2, 850.0, -19.9, 38.4], [110.4, 900.0, -19.4, 37.4], [117.9, 950.0, -18.1, 36.4], [125.6, 1000.0, -16.8, 35.5]] },
        { file: "wood/tree_06.vbuf", soft: "wood/tree_06_soft.vbuf", far: "wood/tree_06_far.vbuf",
          species: "snag", height: 1497.5, r0: 67.5, spread: 305.2, near: 369.2,
